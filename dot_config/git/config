[user]
    email = contact@daniel-espinoza.com
    name = Daniel Espinoza
    signingkey = 5F233DD1F3A48F07B00AD1CF8C8CBFC6D778F65E

[core]
    editor = nvim
    pager = less -F -X
    excludesfile = /home/daniel/.config/git/ignore
    whitespace = error
    fsmonitor = true
    ; untrackedcache = true

    ; NOTE: use `* text=auto`
    ; eol = lf
    ; autocrlf = false

[alias]
    lol = log --decorate --oneline --graph --all
    st = status -s -b -M
    bl = blame -w -C -C -C
    psh = push --force-with-lease --force-if-includes
    rl = reflog --pretty

    amend = commit --amend --no-edit
    wdiff = diff --word-diff
    missing = show-branch --sha1-name --current
    summary = shortlog -sn --no-merges
    purge = clean -fxfd

    pr = !sh -c 'git fetch $1 pull/$2/head:pr-$1-$2 && git checkout pr-$1-$2'
    mr = !sh -c 'git fetch $1 merge-requests/$2/head:mr-$1-$2 && git checkout mr-$1-$2'

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[init]
    defaultBranch = main

[help]
    autocorrect = prompt

[transfer]
    fsckObjects = true

[receive]
    fsckObjects = true

[fetch]
    writeCommitGraph = true
    prune = true
    pruneTags = true
    all = true
    fsckObjects = true

[push]
    default = simple
    followTags = true
    autoSetupRemote = true
    gpgsign = if-asked

[pull]
    default = current
    rebase = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname
    gpgsign = true

[column]
    ui = auto

[rerere]
    enabled = true
    autoupdate = true

[rebase]
    stat = true
    updateRefs = true
    autoSquash = true
    autoStash = true
    missingCommitsCheck = warn

[merge]
    conflictstyle = diff3
    ff = only
    stat = true
    autoStash = true

[diff]
    algorithm = histogram
    colorMoved = plain
    renames = true
    mnemonicPrefix = true

[commit]
    gpgsign = true
    verbose = true

[log]
    date = rfc2822-local
    graphColors = "#8caaee","#81c8be","#ca9ee6","#a6d189","#e78284","#f4b8e4","#ef9f76"

[grep]
    lineNumber = true
    patternType = perl

; [gpg]
;     format = ssh

[color.diff]
    context = "#c6d0f5"
    meta = "#c6d0f5" bold
    frag = "#81c8be"
    new = "#a6d189"
    old = "#e78284"
    oldMoved = "#ca9ee6"
    newMoved = "#8caaee"

[color.status]
    added = "#a6d189"
    changed = "#e78284"
    untracked = "#ca9ee6"
    branch = "#a6d189"
    localBranch = "#a6d189"
    remoteBranch = "#e78284"

[color.decorate]
    branch = "#a6d189" bold
    remoteBranch = "#e78284" bold
    tag = "#e5c890" bold
    HEAD = "#81c8be" bold

[maintenance]
    auto = false
    strategy = incremental

