nnoremap <SPACE> <Nop>

for i in range(97,122)
  let c = nr2char(i)
  exec "map \e".c." <M-".c.">"
  exec "map! \e".c." <M-".c.">"
  exec "iunmap <Esc>".c
  exec "nunmap <Esc>".c
endfor

set background=dark

let mapleader=' '
let maplocalleader='\\'

imap <Esc> <C-c>

set encoding=utf-8
set nocompatible

filetype on
filetype plugin on
filetype indent on

syntax on

set termguicolors
set statusline=
set statusline+=\ %F\ %M\ %Y\ %R
set statusline+=%=
set statusline+=\ hex:\ 0x%B\ percent:\ %p%%\ %l:%c
set laststatus=2

set cursorline

if !isdirectory($HOME."/.vim")
    call mkdir($HOME."/.vim", "", 0770)
endif
if !isdirectory($HOME."/.vim/undo-dir")
    call mkdir($HOME."/.vim/undo-dir", "", 0700)
endif
set undodir=~/.vim/undo-dir
set undofile

set ttimeout
if &ttimeout == -1
    set ttimeoutlen=300
endif
set updatetime=250

set spell
set spelllang=en_us

set incsearch
set hlsearch

set number
set relativenumber
set scrolloff=999

set wrap
set colorcolumn=75

set nobackup
set nowritebackup

set expandtab
set tabstop=4
set shiftwidth=4

set noshowmode
set cursorline
set cmdheight=1
set signcolumn=number
set wildoptions=tagfile

set ignorecase
set smartcase

set splitbelow
set splitright

set list
set listchars=tab:<->,trail:·,nbsp:␣

set virtualedit=block

autocmd FileType json syntax match Comment +\/\/.\+$+

augroup close-with-q
    autocmd!
    au FileType help {
        setlocal nobuflisted
        nnoremap <silent> <buffer> q :close<CR>
    }
augroup END

nnoremap <silent> <Esc> :nohlsearch<CR>

nmap <M-h> <C-w>5<
nmap <M-l> <C-w>5>
nmap <M-k> <C-w>+
nmap <M-j> <C-w>-

nnoremap <silent> <leader>y "+y
vnoremap <silent> <leader>y "+y

nnoremap <silent> <leader>p "+p
inoremap <silent> <C-v>y <C-o>"+p
xnoremap <silent> <leader>p "_dP

nnoremap <silent> <leader>d "_d
vnoremap <silent> <leader>d "_d

nnoremap U <C-r>

nnoremap <leader>xs yy2o<ESC>kpV:!/bin/sh<CR>
vnoremap <leader>xs y'<P'<O<ESC>'>o<ESC>:<C-u>'<,'>!/bin/sh<CR>

nnoremap k gk
nnoremap j gj

nnoremap gh _
vnoremap gh _
nnoremap gl $
vnoremap gl $

nnoremap <leader>qo :copen<CR>
nnoremap <leader>qc :cclose<CR>
nnoremap ]q :cnext<CR>
nnoremap [q :cprevious<CR>
nnoremap ]Q :clast<CR>
nnoremap [Q :cfirst<CR>

nnoremap <leader>lo :lopen<CR>
nnoremap <leader>lc :lclose<CR>
nnoremap ]l :lnext<CR>
nnoremap [l :lprevious<CR>
nnoremap ]L :llast<CR>
nnoremap [L :lfirst<CR>

if filereadable($HOME."/.vim/autoload/plug.vim")
    call plug#begin()

    Plug 'airblade/vim-gitgutter'
    Plug 'tpope/vim-fugitive'
    Plug 'tpope/vim-surround'
    Plug 'tpope/vim-vinegar'
    Plug 'tpope/vim-repeat'
    " Plug 'catppuccin/vim', { 'as': 'catppuccin' }
    Plug 'morhetz/gruvbox'
    Plug 'mbbill/undotree'
    Plug 'junegunn/fzf'

    call plug#end()

    nmap <leader>u :UndotreeToggle<CR>

    let g:gruvbox_contrast_dark = "soft"
    let g:gruvbox_contrast_light = "soft"

    " colorscheme catppuccin_frappe
    colorscheme gruvbox

    hi clear SpellBad
    hi SpellBad cterm=underline,bold ctermfg=red
    hi clear SpellCap
    hi SpellCap cterm=underline,bold ctermfg=yellow
    hi clear SpellLocal
    hi SpellLocal cterm=underline,bold ctermfg=blue
    hi clear SpellRare
    hi SpellRare cterm=underline,bold ctermfg=green
endif
