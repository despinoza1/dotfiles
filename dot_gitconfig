[user]
    email = contact@daniel-espinoza.com
    name = Daniel Espinoza
    signingkey = /home/daniel/.ssh/id_ed25519.pub

[alias]
    lol = log --decorate --oneline --graph --all
    st = status -s -b -M
    bl = blame -w -C -C -C

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[init]
    defaultBranch = main

[core]
    pager = less -F -X
    ; fsmonitor = true
    ; untrackedcache = true

[fetch]
    writeCommitGraph = true
    prune = true
    pruneTags = true
    all = true

[push]
    default = simple
    followTags = true
    autoSetupRemote = true

[pull]
    rebase = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[column]
    ui = auto

[rerere]
    enabled = true
    autoupdate = true

[rebase]
    updateRefs = true
    autoSquash = true
    autoStash = true

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = plain
    renames = true
    mnemonicPrefix = true

[commit]
    gpgsign = true
    verbose = true

[gpg]
    format = ssh

[maintenance]
    auto = false
    strategy = incremental
