[user]
    email = contact@daniel-espinoza.com
    name = Daniel Espinoza
    signingkey = 5F233DD1F3A48F07B00AD1CF8C8CBFC6D778F65E

[alias]
    lol = log --decorate --oneline --graph --all
    st = status -s -b -M
    bl = blame -w -C -C -C
    rl = reflog --pretty

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[init]
    defaultBranch = main

[core]
    pager = less -F -X
    excludesfile = /home/daniel/.gitignore

    ; NOTE: use `* text=auto`
    ; eol = lf
    ; autocrlf = false

    ; NOTE: useful for large repos
    ; fsmonitor = true
    ; untrackedcache = true

[fetch]
    writeCommitGraph = true
    prune = true
    pruneTags = true
    all = true

[push]
    default = simple
    followTags = true
    autoSetupRemote = true
    gpgsign = if-asked

[pull]
    rebase = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname
    gpgsign = true

[column]
    ui = auto

[rerere]
    enabled = true
    autoupdate = true

[rebase]
    updateRefs = true
    autoSquash = true
    autoStash = true
    stat = true

[merge]
    conflictstyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = plain
    renames = true
    mnemonicPrefix = true

[commit]
    gpgsign = true
    verbose = true

[grep]
    lineNumber = true
    patternType = perl

; [gpg]
;     format = ssh

[maintenance]
    auto = false
    strategy = incremental
